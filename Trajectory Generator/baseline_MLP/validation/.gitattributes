test_h0_primary_split_v12r1_*.py text eol=lf
test_freeze_h0_primary_split_v12r1_*.py text eol=lf
h0_v12r1_run_*/**/rl_module_target_adapted/** -text
h0_v12r1_run_*/**/*.json text eol=lf
h0_v12r1_run_*/**/*.md text eol=lf
h0_v12r1_run_*/**/*.txt text eol=lf
h0_v12r1_run_*/**/*.csv text eol=lf
h0_v12r1_run_*/**/*.npz -text
h0_v12r1_run_*/**/*.npy -text
h0_v12r1_run_*/**/*.pkl -text
h0_v12r1_run_*/**/*.zip -text
h0_v12r1_run_*/**/*.bin -text
