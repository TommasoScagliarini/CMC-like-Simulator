    {"id": "{coord}_tracking_qdot_error", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "0", "source": "env", "group": "Tracking SEA", "formula": "qdot_ref - qdot", "note": "Errore qdot in unita fisiche, non pesato direttamente."},
    {"id": "{coord}_reward_q_range", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "scale", "source": "env", "group": "Tracking SEA", "formula": "normalizer q range", "note": "Scala usata per normalizzare position loss."},
