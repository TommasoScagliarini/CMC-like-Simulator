  ],
  "terms": [
    {"id": "positive_preclip", "role": "formula", "stage": "pre-clip", "status": "derived", "weight": "n/a", "source": "compute_reward", "group": "Formula finale", "formula": "blend scores - penalty", "note": "Valore non loggato direttamente; e' la quantita prima del clip."},
    {"id": "reward_base", "role": "reward", "stage": "clip output", "status": "active", "weight": "clip_low=0.0, clip_high=1.0", "source": "compute_reward", "group": "Formula finale", "formula": "clip(positive_preclip, clip_low, clip_high)", "note": "Componente loggata come reward_base."},
    {"id": "reward", "role": "reward", "stage": "final", "status": "active", "weight": "n/a", "source": "compute_reward", "group": "Formula finale", "formula": "reward_base - postclip terms", "note": "Reward scalare restituita all'agente."},
    {"id": "penalty", "role": "penalty", "stage": "pre-clip", "status": "active", "weight": "sum weighted", "source": "compute_reward", "group": "Penalty pre-clip", "formula": "somma dei loss pre-clip pesati", "note": "Sottratta prima del clip."},
