    {"id": "bio_score", "role": "reward", "stage": "pre-clip", "status": "disabled", "weight": "blend_bio=0.00", "source": "compute_reward", "group": "Biologico legacy", "formula": "1 / (1 + bio_weight * bio_loss)", "note": "Calcolato ma non usato nella configurazione ex-novo."},
