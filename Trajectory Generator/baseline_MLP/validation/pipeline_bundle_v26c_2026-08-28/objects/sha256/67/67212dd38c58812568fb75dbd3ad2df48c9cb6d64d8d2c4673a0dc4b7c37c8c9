    {"id": "{coord}_sea_tau_input_raw_rms_nm", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "via sea_saturation_loss", "source": "SimulationRunner", "group": "SEA fisico", "formula": "RMS raw motor input torque", "note": "Copiato da sea_segment_diagnostics."},
    {"id": "{coord}_sea_tau_input_raw_abs_max_nm", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "0", "source": "SimulationRunner", "group": "SEA fisico", "formula": "max(abs(raw motor input torque))", "note": "Copiato da sea_segment_diagnostics."},
    {"id": "{coord}_sea_tau_input_saturation_fraction", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "via sea_saturation_loss", "source": "SimulationRunner", "group": "SEA fisico", "formula": "fraction of raw input beyond clamp", "note": "Copiato da sea_segment_diagnostics."},
