  <script>
    const DATA = JSON.parse(document.getElementById("reward-data").textContent);

    function expandTerms() {
      const expanded = [];
      for (const term of DATA.terms) {
        if (!term.expand) {
          expanded.push({ ...term });
          continue;
        }
        const coords = DATA.coords[term.expand] || [];
        for (const coord of coords) {
          const next = {};
          for (const [key, value] of Object.entries(term)) {
            if (key === "expand") continue;
            next[key] = typeof value === "string" ? value.replaceAll("{coord}", coord) : value;
          }
          expanded.push(next);
        }
      }
      return expanded;
    }

    const TERMS = expandTerms();
    const STAGE_LABELS = {
      "pre-clip": "pre-clip",
      "post-clip": "post-clip",
      "clip output": "clip",
      "final": "finale",
      "source": "sorgente",
      "source + post-clip": "sorgente + post",
      "diagnostic": "diagnostico",
      "termination": "terminazione",
      "imitation only": "solo imitation"
    };

    const STATUS_LABELS = {
      active: "attivo",
      derived: "derivato",
      diagnostic: "diagnostico",
      disabled: "peso zero",
      imitation: "solo imitation"
    };

    function cssClassForTerm(term) {
      if (term.status === "disabled" || term.status === "imitation") return term.status;
      if (term.stage.includes("post-clip")) return "post";
      if (term.role === "penalty") return "penalty";
      if (term.role === "reward") return "reward";
      return "diag";
    }

    function renderFlow() {
      const root = document.getElementById("flow");
      root.innerHTML = "";
      for (const lane of DATA.flow) {
        const node = document.createElement("div");
        node.className = "flow-lane";
        const title = document.createElement("div");
        title.className = "flow-title";
        title.textContent = lane.title;
        node.appendChild(title);
        for (const chip of lane.chips) {
          const item = document.createElement("span");
          item.className = `chip ${chip.className || ""}`;
          item.textContent = chip.text;
          node.appendChild(item);
        }
        root.appendChild(node);
      }
    }

    function renderWeights() {
      const root = document.getElementById("weights");
      root.innerHTML = "";
      for (const group of DATA.weightGroups) {
        const box = document.createElement("div");
        box.className = "weight-group";
        const title = document.createElement("h3");
        title.textContent = group.title;
        box.appendChild(title);
        for (const [name, value] of group.items) {
          const row = document.createElement("div");
          row.className = "weight-row";
          const label = document.createElement("span");
          label.textContent = name;
          const val = document.createElement("span");
          val.className = "weight-value";
          val.textContent = value;
          row.append(label, val);
          box.appendChild(row);
        }
        root.appendChild(box);
      }
    }

    function uniq(values) {
      return [...new Set(values)].sort((a, b) => String(a).localeCompare(String(b)));
    }

    function populateFilters() {
      const stage = document.getElementById("stageFilter");
      const status = document.getElementById("statusFilter");
      const group = document.getElementById("groupFilter");
      for (const value of uniq(TERMS.map((term) => term.stage))) {
        stage.add(new Option(STAGE_LABELS[value] || value, value));
      }
      for (const value of uniq(TERMS.map((term) => term.status))) {
        status.add(new Option(STATUS_LABELS[value] || value, value));
      }
      for (const value of uniq(TERMS.map((term) => term.group))) {
        group.add(new Option(value, value));
      }
    }

    function rowMatches(term, query, stage, status, group) {
      if (stage && term.stage !== stage) return false;
      if (status && term.status !== status) return false;
      if (group && term.group !== group) return false;
      if (!query) return true;
      const haystack = [
        term.id,
        term.role,
        term.stage,
        term.status,
        term.weight,
        term.source,
        term.group,
        term.formula,
        term.note
      ].join(" ").toLowerCase();
      return haystack.includes(query);
    }

    function renderSummary(visibleTerms) {
      const root = document.getElementById("summaryCards");
      const active = visibleTerms.filter((term) => term.status === "active").length;
      const post = visibleTerms.filter((term) => term.stage.includes("post-clip")).length;
      const diag = visibleTerms.filter((term) => term.status === "diagnostic").length;
      const disabled = visibleTerms.filter((term) => term.status === "disabled" || term.status === "imitation").length;
      const values = [
        ["Termini visibili", visibleTerms.length],
        ["Attivi nello scalare", active],
        ["Post-clip", post],
        ["Diagnostici", diag],
        ["Peso zero / imitation", disabled],
        ["Totale espanso", TERMS.length]
      ];
      root.innerHTML = "";
      for (const [label, value] of values) {
        const card = document.createElement("div");
        card.className = "stat-card";
        const num = document.createElement("div");
        num.className = "stat-number";
        num.textContent = value;
        const lab = document.createElement("div");
        lab.className = "stat-label";
        lab.textContent = label;
        card.append(num, lab);
        root.appendChild(card);
      }
    }

    function renderRows() {
      const query = document.getElementById("searchBox").value.trim().toLowerCase();
      const stage = document.getElementById("stageFilter").value;
      const status = document.getElementById("statusFilter").value;
      const group = document.getElementById("groupFilter").value;
      const visible = TERMS.filter((term) => rowMatches(term, query, stage, status, group));
      renderSummary(visible);
      const body = document.getElementById("termRows");
      body.innerHTML = "";
      for (const term of visible) {
        const tr = document.createElement("tr");
        const cls = cssClassForTerm(term);
        tr.innerHTML = `
          <td><div class="term-id"></div><p></p></td>
          <td><span class="pill ${term.role === "penalty" ? "penalty" : term.role === "reward" ? "reward" : "diag"}"></span></td>
          <td><span class="pill ${cls}"></span></td>
          <td><span class="pill ${term.status}"></span></td>
          <td></td>
          <td></td>
          <td></td>
        `;
        tr.children[0].querySelector(".term-id").textContent = term.id;
        tr.children[0].querySelector("p").textContent = term.note || "";
        tr.children[1].querySelector("span").textContent = term.role;
        tr.children[2].querySelector("span").textContent = STAGE_LABELS[term.stage] || term.stage;
        tr.children[3].querySelector("span").textContent = STATUS_LABELS[term.status] || term.status;
        tr.children[4].textContent = term.weight;
        tr.children[5].innerHTML = `<strong>${escapeHtml(term.source)}</strong><br>${escapeHtml(term.formula)}`;
        tr.children[6].textContent = term.group;
        body.appendChild(tr);
      }
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function init() {
      renderFlow();
      renderWeights();
      populateFilters();
      renderRows();
      for (const id of ["searchBox", "stageFilter", "statusFilter", "groupFilter"]) {
        document.getElementById(id).addEventListener("input", renderRows);
        document.getElementById(id).addEventListener("change", renderRows);
      }
      window.REWARD_GRAPH_TERMS = TERMS;
    }

    init();
  </script>
</body>
</html>
