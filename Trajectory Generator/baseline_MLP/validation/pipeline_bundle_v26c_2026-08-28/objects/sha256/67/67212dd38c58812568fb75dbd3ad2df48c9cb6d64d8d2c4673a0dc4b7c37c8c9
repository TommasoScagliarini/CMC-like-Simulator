    {"id": "{coord}_reference_acceleration_abs_max_rad_s2", "expand": "prosthetic", "role": "diagnostic", "stage": "diagnostic", "status": "diagnostic", "weight": "0", "source": "env", "group": "Reference model", "formula": "served acceleration abs max", "note": "Diagnostico per coordinata."},
