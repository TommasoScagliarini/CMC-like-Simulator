    {"id": "contact_load_score", "role": "reward", "stage": "pre-clip", "status": "active", "weight": "blend_contact_load=0.35", "source": "wrapper", "group": "Contatto protesico", "formula": "clip(normal_force_bw / contact_load_target_bw, 0, 1)", "note": "Attivo solo quando la stance protesica e' attesa."},
