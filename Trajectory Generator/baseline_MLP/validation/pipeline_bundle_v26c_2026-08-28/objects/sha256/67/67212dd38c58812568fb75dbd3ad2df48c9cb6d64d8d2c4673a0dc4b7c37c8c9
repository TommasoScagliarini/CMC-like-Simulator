    {"id": "sea_tau_spring_effort_loss", "role": "penalty", "stage": "pre-clip", "status": "disabled", "weight": "sea_tau_spring_effort_weight=0.00", "source": "env", "group": "SEA fisico", "formula": "bounded tau_spring_rms / F_opt", "note": "Visualizzato ma non pesato attualmente."},
