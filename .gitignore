# Ignore bundle-local data contents, but keep .osim files in models/ tracked
models/**/data/**
!models/**/data/
!models/**/data/**/
!models/**/data/.gitkeep
!models/**/data/**/.gitkeep
models/*-raw/

# Ignore plugin and result contents, but keep the folders tracked
plugins/*
results/*

# RL training/rollout outputs (checkpoints, summaries) are reproducible
runs/
!Trajectory Generator/runs/
Trajectory Generator/runs/*
!Trajectory Generator/runs/historical_runs.md
!Trajectory Generator/runs/historical_runs.index.json
!Trajectory Generator/runs/historical_runs.manual.yaml

# Generated plots are reproducible from results/reports; keep plotter source.
plot/**
!plot/
!plot/plotter.py

# Local CMake/build products for experimental plugins and tools.
tools/**/build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.o
*.d
*.dylib
*.so
*.dll

# Keep the folders themselves in the repository
!models/.gitkeep
!plugins/.gitkeep

# OpenSim log (can exceed GitHub 100 MB limit)
opensim.log

# Local state for the most recently used simulator setup XML
.simulator_last_setup.json

# System / editor / cache files
.DS_Store
__pycache__/
*.pyc
.vscode/
.claude/

# Documenti di handover generati localmente (snapshot temporanei)
HANDOVER_LLM_*.md

# Risultati grezzi > 100 MB: non pushabili su GitHub senza LFS (2026-08-21)
validation/binary_phase_detector_v21_runs/2026-08-04_run01/fine_results.jsonl

# The V26C closure is an intentional content-addressed archive.  Its short
# SHA-256 object paths are deliverable on Windows; the first local prototype
# with duplicated repo-relative paths is an ignored migration cache.
Trajectory Generator/baseline_MLP/validation/pipeline_bundle_v26c_2026-08-28/repository_snapshot/
!Trajectory Generator/baseline_MLP/validation/pipeline_bundle_v26c_2026-08-28/objects/
!Trajectory Generator/baseline_MLP/validation/pipeline_bundle_v26c_2026-08-28/objects/**
