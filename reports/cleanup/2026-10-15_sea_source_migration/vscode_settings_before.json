                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (TeX Live)",
            "tools": [
                "latexmk-texbin"
            ]
        }
    ]
