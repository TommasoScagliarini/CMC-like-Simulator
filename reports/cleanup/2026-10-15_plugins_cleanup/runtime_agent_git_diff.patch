+LEGACY_MODEL_DIRECTORIES["SEASEA - whealthy data"] = "SEASEA_healthy"
+MODEL_FAMILIES = frozenset(("AB06", "AB07", "AB08", "SEASEA", "SEASEA_healthy"))
